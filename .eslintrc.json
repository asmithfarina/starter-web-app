{
  "env": {
    "node": true,
    "browser": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ]
  }
}
